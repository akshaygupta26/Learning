# Copy to .env and fill in. .env is gitignored.

# TCGCSV asks for a descriptive User-Agent identifying the operator.
POKEDB_USER_AGENT="pokemon-price-db/0.1 (+you@example.com)"

# Your eBay final value fee rate.
# 0.1325 is the retail rate. OVERRIDE THIS ON AUG 17 with the employee rate —
# it is the single most important number in the model. See PLAN.md section 3.
EBAY_FVF_RATE=0.1325

# Phase 5. Graded prices via PokemonPriceTracker API tier ($9.99/mo).
PPT_API_KEY=

# Phase 3. eBay Browse API (free, 5k calls/day).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
